[Unit]
Description=PisoWiFi portal and vending server
# time-sync.target matters more than it looks: the Orange Pi One has no
# battery-backed clock, so at boot the wall clock is whatever was last saved
# and jumps when NTP lands. Session expiry is stored as an absolute timestamp,
# so resync() computing "expires_at - now" against a pre-sync clock gets the
# remaining time wrong for every paying customer.
After=network.target nftables.service pisowifi-detect.service time-sync.target
Wants=nftables.service pisowifi-detect.service time-sync.target

[Service]
Type=simple
Environment=PISOWIFI_CONFIG=/etc/pisowifi/config.json
ExecStart=/usr/bin/python3 /opt/pisowifi/main.py
Restart=always
RestartSec=3
User=root

# The app needs root for nft / tc / GPIO, so it can't be fully sandboxed —
# but these three cost nothing and close the easy paths: no setuid
# escalation, no access to /home or /root, and its own private /tmp.
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
